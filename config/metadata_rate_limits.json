{
  "schema_version": "1.0",
  "global": {
    "concurrency": 1,
    "paper_interval_seconds": 8.0,
    "jitter_seconds": 1.5,
    "max_retries": 5,
    "timeout_seconds": 30,
    "retry_after_respected": true
  },
  "providers": {
    "crossref": {
      "enabled": true,
      "min_interval_seconds": 3.0,
      "mailto": "CHANGE_ME@example.com",
      "user_agent": "MinerU/1.0 (mailto:CHANGE_ME@example.com)",
      "adaptive_from_headers": true
    },
    "openalex": {
      "enabled": true,
      "min_interval_seconds": 2.0,
      "mailto": "CHANGE_ME@example.com",
      "user_agent": "MinerU/1.0 (mailto:CHANGE_ME@example.com)",
      "adaptive_from_headers": true
    },
    "semantic_scholar": {
      "enabled": false,
      "min_interval_seconds": 1.2,
      "api_key_env": "SEMANTIC_SCHOLAR_API_KEY"
    }
  },
  "backoff": {
    "on_429_initial_sleep_seconds": 60,
    "on_403_initial_sleep_seconds": 300,
    "multiplier": 2.0,
    "max_sleep_seconds": 1800
  }
}
