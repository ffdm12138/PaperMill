{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "paper_raw catalog v3.1 (LLM content index)",
  "description": "Catalog v3.1 carries only content understanding from MinerU Markdown. Bibliographic facts stay in metadata.json.",
  "type": "object",
  "required": [
    "schema_version",
    "library_locator",
    "content_identity",
    "classification",
    "screening",
    "research_card",
    "writing_value",
    "evidence_profile",
    "figure_inventory",
    "terminology",
    "quality_control",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "3.1" },
    "library_locator": {
      "type": "object",
      "required": ["paper_number", "paper_id", "paper_dir", "asset_refs"],
      "properties": {
        "paper_number": { "type": "string" },
        "paper_id": { "type": "string" },
        "paper_dir": { "type": "string" },
        "asset_refs": {
          "type": "object",
          "required": ["markdown", "pdf", "metadata", "catalog", "asset_manifest", "images_dir"],
          "properties": {
            "markdown": { "type": "string" },
            "pdf": { "type": "string" },
            "metadata": { "type": "string" },
            "catalog": { "type": "string" },
            "asset_manifest": { "type": "string" },
            "images_dir": { "type": "string" }
          }
        }
      }
    },
    "content_identity": { "type": "object" },
    "classification": { "type": "object" },
    "screening": { "type": "object" },
    "research_card": { "type": "object" },
    "writing_value": { "type": "object" },
    "evidence_profile": { "type": "object" },
    "figure_inventory": { "type": "object" },
    "terminology": { "type": "array" },
    "quality_control": { "type": "object" },
    "provenance": { "type": "object" }
  },
  "not": {
    "anyOf": [
      { "required": ["paper_number"] },
      { "required": ["paper_id"] },
      { "required": ["asset_refs"] },
      { "required": ["naming"] },
      { "required": ["content_notes"] }
    ]
  }
}
