{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task_input_sha256", "paper_number", "paper_id", "decisions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "format": "uuid"},
    "task_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "paper_number": {"type": "string", "pattern": "^[0-9]{16}$"},
    "paper_id": {"type": "string", "minLength": 1},
    "decisions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["category_id", "matched", "confidence", "reason_zh", "catalog_evidence_fields"],
        "properties": {
          "category_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
          "matched": {"type": "boolean"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "reason_zh": {"type": "string", "minLength": 1},
          "catalog_evidence_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
