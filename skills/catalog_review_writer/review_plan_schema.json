{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CatalogReviewPlan",
  "description": "Machine-checkable plan emitted by the catalog_review_writer skill. Every gap and direction must carry an evidence chain (paper_number + bib_key); the paper pool must exactly cover the job's selected papers. Citations come only from job-local Metadata; Catalog is content understanding only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "job_id", "workflow", "title_zh", "topic_zh",
    "language", "source_categories", "paper_pool", "themes",
    "research_gaps", "proposed_directions", "sections"
  ],
  "definitions": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "paperNumber": {"type": "string", "pattern": "^[0-9]{16}$"},
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_number", "bib_key", "basis_zh"],
      "properties": {
        "paper_number": {"$ref": "#/definitions/paperNumber"},
        "bib_key": {"$ref": "#/definitions/nonEmptyString"},
        "basis_zh": {"$ref": "#/definitions/nonEmptyString"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "job_id": {"$ref": "#/definitions/nonEmptyString"},
    "workflow": {"const": "catalog_review"},
    "title_zh": {"$ref": "#/definitions/nonEmptyString"},
    "topic_zh": {"$ref": "#/definitions/nonEmptyString"},
    "language": {"type": "string", "enum": ["zh", "en"]},
    "source_categories": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/definitions/nonEmptyString"}
    },
    "paper_pool": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paper_number", "paper_name", "bib_key", "role_in_review_zh"],
        "properties": {
          "paper_number": {"$ref": "#/definitions/paperNumber"},
          "paper_name": {"$ref": "#/definitions/nonEmptyString"},
          "bib_key": {"$ref": "#/definitions/nonEmptyString"},
          "role_in_review_zh": {"$ref": "#/definitions/nonEmptyString"}
        }
      }
    },
    "themes": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["theme_id", "theme_zh", "thesis_zh", "evidence"],
        "properties": {
          "theme_id": {"type": "string", "pattern": "^T[0-9]{2}$"},
          "theme_zh": {"$ref": "#/definitions/nonEmptyString"},
          "thesis_zh": {"$ref": "#/definitions/nonEmptyString"},
          "evidence": {
            "type": "array", "minItems": 2,
            "items": {"$ref": "#/definitions/evidenceRef"}
          }
        }
      }
    },
    "research_gaps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "gap_zh", "why_it_matters_zh", "evidence"],
        "properties": {
          "gap_id": {"type": "string", "pattern": "^G[0-9]{2}$"},
          "gap_zh": {"$ref": "#/definitions/nonEmptyString"},
          "why_it_matters_zh": {"$ref": "#/definitions/nonEmptyString"},
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {"$ref": "#/definitions/evidenceRef"}
          }
        }
      }
    },
    "proposed_directions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["direction_id", "direction_zh", "rationale_zh",
                     "addresses_gap_ids", "builds_on", "feasibility_zh"],
        "properties": {
          "direction_id": {"type": "string", "pattern": "^D[0-9]{2}$"},
          "direction_zh": {"$ref": "#/definitions/nonEmptyString"},
          "rationale_zh": {"$ref": "#/definitions/nonEmptyString"},
          "addresses_gap_ids": {
            "type": "array", "minItems": 1,
            "items": {"type": "string", "pattern": "^G[0-9]{2}$"}
          },
          "builds_on": {
            "type": "array", "minItems": 1,
            "items": {"$ref": "#/definitions/evidenceRef"}
          },
          "feasibility_zh": {"type": ["string", "null"]}
        }
      }
    },
    "sections": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "title_zh", "purpose_zh"],
        "properties": {
          "file": {"type": "string", "pattern": "^sections/[a-z0-9_]+\\.tex$"},
          "title_zh": {"$ref": "#/definitions/nonEmptyString"},
          "purpose_zh": {"$ref": "#/definitions/nonEmptyString"},
          "theme_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^T[0-9]{2}$"}
          }
        }
      }
    }
  }
}
