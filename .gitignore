data/raw_all/**
!data/raw_all/.gitkeep
data/discovery/queries/**
!data/discovery/queries/.gitkeep
!data/discovery/queries/keywords.example.txt
_test_batch/
!data/raw/.gitkeep
!data/paper_raw/.gitkeep
!data/papers/.gitkeep
!data/catalog/.gitkeep
!data/tmp/.gitkeep
!data/logs/.gitkeep
!data/jobs/.gitkeep
!data/transactions/.gitkeep
!data/discovery/.gitkeep
!data/discovery/doi_candidates/.gitkeep
!data/discovery/pdf_fetch_logs/.gitkeep
!data/discovery/pending_pages/.gitkeep
!data/discovery/locks/.gitkeep
!data/discovery/exports/.gitkeep
!data/catalog/*.template.json

# ===== 写作任务产物（可重新生成，不入库）=====
write/jobs/**
# legacy 旧根 write/<job_id>/ 兜底保护，防止误提交（不影响 write/README.md 与 write/jobs/）
write/[0-9][0-9][0-9]_*/
write/job_*/
write/*_review*/
!write/.gitkeep
!write/README.md
!write/jobs/
!write/jobs/.gitkeep

# ===== 日志与临时 =====
*.log
# Local MinerU raw output cache/history, never commit
output/
.DS_Store
Thumbs.db

# Local backup / repair artifacts
*.bak
*.bak.*
*.backup
*.backup.*
*.tmp
*.temp

# Runtime catalog / ledger artifacts
data/catalog/paper_number_ledger.json
data/catalog/paper_number_ledger.json.bak
data/catalog/paper_number_ledger.bak_*.json
data/catalog/*.bak
data/catalog/*.bak.*
data/catalog/*.backup
data/catalog/*.backup.*
data/catalog/*.runtime.json

# ===== 仓库快照 zip（pack_repo.py 生成，不入库）=====
mineru_snapshot*.zip

