data/discovery/locks/**
data/discovery/exports/**
data/discovery/logs/**
data/discovery/reports/**
data/catalog/all.catalog.json
data/catalog/paper_index.json
data/catalog/paper_number_ledger.json
data/catalog/catalog_migration_report.json
data/catalog/metadata_quality_report.json
data/cleanup_report.json
data/locks/*.lock
reports/*.json
reports/*.err
reports/*.txt
reports/*.md
reports/*.csv
!reports/.gitkeep
import/
# 本地导入工作产物（DOI 批量列表等），不进项目快照
data/import_work/**
