# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ===== Local agent / research tooling state (never commit or pack) =====
.reasonix/
# Tombstone files from test migration — must never re-enter repo or snapshot
*._deleted
*.py._deleted

# ===== 数据语料（受版权保护，不入库）=====
# PDF 原文与派生 md/图：体积大且含版权，不推送到远程
data/raw/**
data/paper_raw/**
data/papers/**
data/llm_work/**
data/tmp/**
data/logs/**
data/jobs/**
data/transactions/**
data/jobs/upload_staging/**
data/discovery/doi_candidates/**
